# WinUse 配置模板：复制为 .env 后按需修改。
# ⚠️ .env 不入库（可能含本机路径/凭据）；本文件只放**占位符示例**。
# 所有键都在 winuse/config.py 里定义，且**只从 .env 读，不读进程环境变量**。

# cua-driver 可执行文件。留空 = 自动探测（优先 ~/.cua-driver/packages/current，
# 其次 %LOCALAPPDATA%/Programs/Cua/...，最后才 PATH）。
# 路径含空格时用引号；反斜杠按字面处理（不会被当转义符）。
WINUSE_CUA_DRIVER=

# 单次驱动调用超时（秒）
WINUSE_TIMEOUT_S=120

# 数据目录（审计日志等）
# 审计文件的三级规则：WINUSE_AUDIT_PATH > WINUSE_DATA_DIR/audit.jsonl > ~/.winuse/audit.jsonl
WINUSE_DATA_DIR=~/.winuse

# 审计文件路径（显式指定，优先级最高）
WINUSE_AUDIT_PATH=

# 审计轮转：单文件上限（字节）与保留归档份数
# MAX_BYTES=0 表示关闭轮转只追加；KEEP=0 表示不留归档（旧日志直接丢弃）
WINUSE_AUDIT_MAX_BYTES=5242880
WINUSE_AUDIT_KEEP=3

# 状态输出裁剪：单次最多回传多少个可交互元素（防 Token 爆炸）
WINUSE_STATE_MAX_ELEMENTS=200

# 读图路由（P5）：本地视觉模型优先，云端仅备选；
# 仅当本地显存被大模型占用时才走云端，且禁止为读图驱逐正在跑的模型。
# 真实端点写在这里（本模板只给占位符）。
WINUSE_VISION_LOCAL_ENDPOINT=<LMSTUDIO_ENDPOINT>
WINUSE_VISION_LOCAL_MODEL=<LOCAL_VLM_NAME>
WINUSE_VISION_CLOUD_FALLBACK=<CLOUD_VISION_MODEL>
